# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.

# Required: Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model id (default claude-opus-5-5). Faster / cheaper alternatives:
# claude-sonnet-5-5, claude-haiku-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: an Anthropic-compatible gateway
# ANTHROPIC_BASE_URL=

# Optional: server-side refusal fallback (beta) is on by default; set "off" for gateways that reject beta params
# ANTHROPIC_FALLBACKS=off

# Optional: fast mode on supported models (higher price, faster output)
# ANTHROPIC_FAST_MODE=on
